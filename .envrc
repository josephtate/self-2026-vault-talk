watch_file .git/HEAD
watch_file .git/refs/heads

export GITHUB_REPO="jtate-vault-talk"
export GITHUB_OWNER="ctrliq"
export NAMESPACE_PREFIX="dev"
export CLUSTER_NAME="vault-talk"

GITHUB_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'main')
export GITHUB_BRANCH

# Cache VAULT_ADDR from minikube service, refresh every 30 minutes
VAULT_ADDR_CACHE=".envrc.${USER}.minikube-service"
CACHE_MAX_AGE=1800

if [[ -f "$VAULT_ADDR_CACHE" ]] && [[ $(( $(date +%s) - $(stat -c %Y "$VAULT_ADDR_CACHE") )) -lt $CACHE_MAX_AGE ]]; then
  VAULT_ADDR=$(cat "$VAULT_ADDR_CACHE")
else
  VAULT_ADDR=$(minikube -p $CLUSTER_NAME service "dev-vault" -n "dev-vault" --url 2>/dev/null | head -n1 || echo "")
  [[ -n "$VAULT_ADDR" ]] && echo "$VAULT_ADDR" > "$VAULT_ADDR_CACHE"
fi
export VAULT_ADDR

PATH_add manual/scripts

source_env_if_exists ".envrc.${USER}"
